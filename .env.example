# Neon Postgres connection string (required)
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Anthropic (required for AI explanations; without it issues are marked "skipped")
ANTHROPIC_API_KEY=
# Model used for explanations (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Max issues per scan sent to the AI, most severe first (default: 30)
MAX_AI_ISSUES=30

# Inngest (optional in local dev; set automatically by the Vercel integration)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# PostHog (optional; used from Phase 4)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Local Chromium override (optional), e.g. /opt/pw-browsers/chromium
CHROMIUM_EXECUTABLE_PATH=

# Set to 1 to allow scanning localhost / private IPs (tests, eval fixtures)
ALLOW_PRIVATE_URLS=
